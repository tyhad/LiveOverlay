{
  "name": "liveoverlay",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:css": "tailwindcss -i src/styles/input.css -o public/styles.css --watch",
    "build:css": "tailwindcss -i src/styles/input.css -o public/styles.css --minify",
    "build:js": "bun build src/client/app.ts --outdir public/js --minify",
    "build": "bun run build:css && bun run build:js",
    "start": "bun src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@elysiajs/static": "^1.4.10",
    "@tailwindcss/cli": "^4.3.3",
    "elysia": "^1.4.29",
    "gsap": "^3.15.0",
    "tailwindcss": "^4.3.3"
  }
}
