{
  "name": "liveoverlay",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:css": "tailwindcss -i src/styles/input.css -o public/styles.css --watch",
    "build:css": "tailwindcss -i src/styles/input.css -o public/styles.css --minify",
    "build": "bun run build:css",
    "start": "bun src/index.ts",
    "test": "bun tests/animation-engine.test.mjs"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "gsap": "^3.12.5",
    "jsdom": "^30.0.1"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@elysiajs/static": "^1.4.10",
    "@tailwindcss/cli": "^4.3.3",
    "elysia": "^1.4.29",
    "tailwindcss": "^4.3.3",
    "tiktok-live-connector": "^2.4.4"
  }
}
