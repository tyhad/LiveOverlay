{
  "id": "default",
  "name": "Live Streaming Scene",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "backgroundColor": "transparent"
  },
  "elements": [
    {
      "id": "banner-bg",
      "type": "shape",
      "name": "Announcement Box",
      "x": 60,
      "y": 940,
      "width": 680,
      "height": 65,
      "rotation": 0,
      "opacity": 0.95,
      "zIndex": 1,
      "hidden": false,
      "locked": false,
      "style": {
        "backgroundColor": "#090d16",
        "borderRadius": 20,
        "borderWidth": 1.5,
        "borderColor": "#334155",
        "borderStyle": "solid",
        "shadowColor": "rgba(0,0,0,0.6)",
        "shadowBlur": 24,
        "shadowOffsetX": 0,
        "shadowOffsetY": 6,
        "gradient": {
          "enabled": true,
          "from": "#0f172a",
          "to": "#020617",
          "angle": 135
        }
      },
      "animation": {
        "loop": false,
        "sequence": [
          {
            "id": "q0",
            "type": "from",
            "properties": { "opacity": 0, "y": 1000 },
            "duration": 0.8,
            "delay": 0.3,
            "ease": "power3.out"
          },
          {
            "id": "q1",
            "type": "to",
            "properties": { "scale": 1.04 },
            "duration": 1.6,
            "repeat": -1,
            "yoyo": true,
            "ease": "power1.inOut"
          }
        ]
      }
    },
    {
      "id": "banner-text",
      "type": "text",
      "name": "Running Stream Text",
      "x": 84,
      "y": 958,
      "width": 630,
      "height": 30,
      "rotation": 0,
      "opacity": 1,
      "zIndex": 2,
      "hidden": false,
      "locked": false,
      "style": {
        "text": "Welcome to the stream! Jangan lupa Tap-tap layar & Follow!",
        "fontFamily": "Poppins, sans-serif",
        "fontSize": 17,
        "fontWeight": "600",
        "color": "#f8fafc",
        "backgroundColor": "transparent",
        "textAlign": "left",
        "textTransform": "none",
        "letterSpacing": 0.5,
        "padding": 0,
        "borderRadius": 0,
        "borderWidth": 0,
        "borderColor": "transparent"
      },
      "textBinding": {
        "enabled": true,
        "source": "platform",
        "field": "latestChatMessage",
        "prefix": "CHAT: ",
        "fallback": "Welcome to the stream! Jangan lupa Tap-tap layar & Follow!",
        "format": "raw"
      },
      "animation": {
        "loop": false,
        "sequence": [
          {
            "id": "q0",
            "type": "from",
            "properties": { "opacity": 0 },
            "duration": 0.6,
            "delay": 0.6,
            "ease": "power2.out"
          }
        ]
      }
    },
    {
      "id": "badge-bg",
      "type": "shape",
      "name": "TikTok Badge BG",
      "x": 60,
      "y": 860,
      "width": 280,
      "height": 60,
      "rotation": -2,
      "opacity": 0.95,
      "zIndex": 3,
      "hidden": false,
      "locked": false,
      "style": {
        "backgroundColor": "#18181b",
        "borderRadius": 18,
        "borderWidth": 2,
        "borderColor": "#ec4899",
        "borderStyle": "solid",
        "shadowColor": "rgba(236,72,153,0.4)",
        "shadowBlur": 20,
        "shadowOffsetX": 0,
        "shadowOffsetY": 4,
        "gradient": {
          "enabled": true,
          "from": "#27272a",
          "to": "#09090b",
          "angle": 90
        }
      },
      "animation": {
        "loop": false,
        "sequence": [
          {
            "id": "q0",
            "type": "from",
            "properties": { "opacity": 0, "y": 960, "scale": 0.8 },
            "duration": 0.9,
            "delay": 0.1,
            "ease": "bounce.out"
          },
          {
            "id": "q1",
            "type": "to",
            "properties": { "y": 850 },
            "duration": 1.3,
            "repeat": -1,
            "yoyo": true,
            "ease": "sine.inOut"
          }
        ]
      }
    },
    {
      "id": "badge-text",
      "type": "text",
      "name": "TikTok Username",
      "x": 82,
      "y": 875,
      "width": 240,
      "height": 30,
      "rotation": -2,
      "opacity": 1,
      "zIndex": 4,
      "hidden": false,
      "locked": false,
      "style": {
        "text": "@creator_stream",
        "fontFamily": "Outfit, sans-serif",
        "fontSize": 20,
        "fontWeight": "800",
        "color": "#f43f5e",
        "backgroundColor": "transparent",
        "textAlign": "left",
        "textTransform": "none",
        "letterSpacing": 1,
        "padding": 0,
        "borderRadius": 0,
        "borderWidth": 0,
        "borderColor": "transparent"
      },
      "textBinding": {
        "enabled": true,
        "source": "platform",
        "field": "username",
        "prefix": "LIVE ",
        "fallback": "@creator_stream",
        "format": "raw"
      },
      "animation": {
        "loop": false,
        "sequence": [
          {
            "id": "q0",
            "type": "from",
            "properties": { "opacity": 0, "scale": 0.3 },
            "duration": 0.7,
            "delay": 0.35,
            "ease": "back.out(1.7)"
          },
          {
            "id": "q1",
            "type": "to",
            "properties": { "y": 865 },
            "duration": 1.3,
            "repeat": -1,
            "yoyo": true,
            "ease": "sine.inOut"
          }
        ]
      }
    }
  ]
}
